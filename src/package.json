{
  "name": "hornet-remote-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Unified remote workstation",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/start.mjs",
    "dev": "npm run build && node tools/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "test:desktop": "node tools/smoke.mjs",
    "test:native": "node tools/native-smoke.mjs",
    "test:startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/startup-smoke.ps1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0",
    "ws": "8.21.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
