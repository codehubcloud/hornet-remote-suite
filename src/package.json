{
  "name": "hornet-remote-suite",
  "version": "0.0.1",
  "private": true,
  "description": "Unified remote workstation",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/start.mjs",
    "dev": "npm run build && node tools/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test:locales && npm test && npm run build",
    "test:desktop": "node tools/smoke.mjs",
    "test:native": "node tools/native-smoke.mjs",
    "test:x11-engine": "node tools/x11-engine-smoke.mjs",
    "test:xdmcp": "node tools/xdmcp-smoke.mjs",
    "test:x11-ui": "node tools/x11-ui-smoke.mjs",
    "test:startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/startup-smoke.ps1",
    "test:suite-ui": "node tools/suite-workspace-smoke.mjs",
    "test:terminal-ui": "node tools/terminal-tools-smoke.mjs",
    "test:telnet-logs": "node tools/telnet-logs-smoke.mjs",
    "test:device-terminals": "node tools/device-terminals-smoke.mjs",
    "test:workspace-navigation": "node tools/workspace-navigation-smoke.mjs",
    "test:appearance": "node tools/appearance-smoke.mjs",
    "test:locales": "node tools/check-locales.mjs",
    "test:sessions-ui": "node tools/sessions-dialog-smoke.mjs",
    "test:session-advanced": "node tools/session-advanced-smoke.mjs",
    "test:terminal-automation": "node tools/terminal-automation-smoke.mjs",
    "test:file-sync": "node tools/file-sync-smoke.mjs",
    "build:release": "node tools/build.mjs --release",
    "package": "npm run build:release && electron-builder --config electron-builder.cjs --publish never",
    "package:dir": "npm run build:release && electron-builder --config electron-builder.cjs --dir --publish never",
    "test:package": "node tools/package-smoke.mjs",
    "test:release": "node --test tests/release/*.test.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "basic-ftp": "6.2.3",
    "iconv-lite": "0.7.3",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serialport": "13.0.0",
    "ssh2": "1.17.0",
    "ws": "8.21.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "author": {
    "name": "codehubcloud",
    "email": "codehubcloud@users.noreply.github.com"
  },
  "license": "UNLICENSED"
}
