{
  "name": "hornet-remote-suite",
  "version": "0.0.28",
  "private": true,
  "description": "Unified remote workstation",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "prepare:runtime": "node node_modules/electron/install.js",
    "prepare:icons": "node tools/prepare-icons.mjs",
    "start": "node tools/start.mjs",
    "dev": "npm run build && node tools/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test:locales && npm test && npm run build",
    "test:advanced-menus": "node tools/advanced-menus-smoke.mjs",
    "test:advanced-menus:package": "node tools/advanced-menus-smoke.mjs --packaged",
    "test:desktop": "node tools/smoke.mjs",
    "test:native": "node tools/native-smoke.mjs",
    "test:x11-engine": "node tools/x11-engine-smoke.mjs",
    "test:xdmcp": "node tools/xdmcp-smoke.mjs",
    "test:x11-ui": "node tools/x11-ui-smoke.mjs",
    "test:startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/startup-smoke.ps1",
    "test:suite-ui": "node tools/suite-workspace-smoke.mjs",
    "test:terminal-ui": "node tools/terminal-tools-smoke.mjs",
    "test:telnet-logs": "node tools/telnet-logs-smoke.mjs",
    "test:device-terminals": "node tools/device-terminals-smoke.mjs",
    "test:workspace-navigation": "node tools/workspace-navigation-smoke.mjs",
    "test:appearance": "node tools/appearance-smoke.mjs",
    "test:locales": "node tools/check-locales.mjs",
    "test:sessions-ui": "node tools/sessions-dialog-smoke.mjs",
    "test:session-advanced": "node tools/session-advanced-smoke.mjs",
    "test:terminal-automation": "node tools/terminal-automation-smoke.mjs",
    "test:file-sync": "node tools/file-sync-smoke.mjs",
    "build:release": "node tools/build.mjs --release",
    "package": "npm run prepare:runtime && npm run build:release && electron-builder --config electron-builder.cjs --publish never",
    "package:dir": "npm run prepare:runtime && npm run build:release && electron-builder --config electron-builder.cjs --dir --publish never",
    "test:package": "node tools/package-smoke.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "test:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/installer-smoke.ps1",
    "test:installer:startup": "node tools/installer-startup-smoke.mjs",
    "test:clipboard": "node tools/terminal-clipboard-smoke.mjs",
    "test:clipboard:package": "node tools/terminal-clipboard-smoke.mjs --packaged",
    "test:transfer-reliability": "node tools/transfer-reliability-smoke.mjs",
    "test:transfer-reliability:package": "node tools/transfer-reliability-smoke.mjs --packaged",
    "test:shutdown": "node tools/shutdown-smoke.mjs",
    "test:shutdown:package": "node tools/shutdown-smoke.mjs --packaged",
    "test:titlebar": "node tools/titlebar-smoke.mjs",
    "test:titlebar:package": "node tools/titlebar-smoke.mjs --packaged",
    "test:terminal-tabs": "node tools/terminal-tabs-smoke.mjs",
    "test:terminal-tabs:package": "node tools/terminal-tabs-smoke.mjs --packaged",
    "test:terminal-disconnect": "node tools/terminal-disconnect-smoke.mjs",
    "test:connection-failure": "node tools/connection-failure-smoke.mjs",
    "test:terminal-disconnect:package": "node tools/terminal-disconnect-smoke.mjs --packaged",
    "test:session-tabs": "node tools/session-tabs-credentials-smoke.mjs",
    "test:profile-password": "node tools/profile-password-smoke.mjs",
    "test:profile-password:package": "node tools/profile-password-smoke.mjs --packaged",
    "test:session-tabs:package": "node tools/session-tabs-credentials-smoke.mjs --packaged",
    "test:xshell-workspace": "node tools/xshell-workspace-smoke.mjs",
    "test:xshell-workspace:package": "node tools/xshell-workspace-smoke.mjs --packaged",
    "test:help": "node tools/help-smoke.mjs",
    "test:help:package": "node tools/help-smoke.mjs --packaged"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/xterm": "6.0.0",
    "basic-ftp": "6.2.3",
    "iconv-lite": "0.7.3",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serialport": "13.0.0",
    "ssh2": "1.17.0",
    "ws": "8.21.3",
    "zmodem.js": "0.1.10",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "author": {
    "name": "codehubcloud",
    "email": "codehubcloud@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/codehubcloud/hornet-remote-suite-release"
}
